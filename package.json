{
  "name": "json11",
  "version": "3.0.0-alpha.1",
  "description": "JSON for humans and machines",
  "bin": "./dist/cli.mjs",
  "browser": "./dist/umd/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/es/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "main": "./dist/cjs/index.cjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "src/",
    "dist/"
  ],
  "scripts": {
    "build": "npm run build:lib && npm run build:cli && npm run build:mini && npm run build:type",
    "build:lib": "vite build",
    "build:cli": "vite build --mode cli",
    "build:mini": "MINIFY=true vite build",
    "build:type": "dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --export-referenced-types --umd-module-name=JSON11 && cp ./dist/index.d.ts ./dist/index.d.cts",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "test": "vitest --run",
    "test:heap": "NODE_OPTIONS=--expose-gc vitest --run test/heapHygiene.test.ts",
    "bench": "vitest bench --run",
    "prepublishOnly": "npm i && npm run test && npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMoo-Miki/json11.git"
  },
  "keywords": [
    "json",
    "json5",
    "json11",
    "es2020",
    "ecmascript"
  ],
  "author": "AMoo-Miki",
  "contributors": [
    "Aseem Kishore <aseem.kishore@gmail.com>",
    "Max Nanasy <max.nanasy@gmail.com>",
    "Andrew Eisenberg <andrew@eisenberg.as>",
    "Jordan Tucker <jordanbtucker@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AMoo-Miki/json11/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.13.1",
    "@vitest/coverage-istanbul": "^4.1.8",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
